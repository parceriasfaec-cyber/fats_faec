# Copie este arquivo para ".env" (na mesma pasta do app.py) e preencha
# com a string de conexão do seu projeto Supabase.
#
# Onde encontrar: no painel do Supabase -> Project Settings -> Database
# -> "Connection string" -> aba "URI" (marque "Use connection pooling"
# se preferir a porta 6543, ou use a direta na porta 5432).
#
# Troque [YOUR-PASSWORD] pela senha do banco que você definiu ao criar
# o projeto.

DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Chave secreta do Flask (usada para mensagens de flash/sessao). Pode ser
# qualquer texto aleatorio - troque por algo unico e nao compartilhe.
SECRET_KEY=troque-por-um-texto-aleatorio-bem-grande

# Supabase Storage (guarda as fotos dos produtores na nuvem).
# Onde encontrar: painel do Supabase -> Project Settings -> API
#   SUPABASE_URL         -> campo "Project URL"
#   SUPABASE_SERVICE_KEY -> campo "service_role" (em "Project API keys")
# IMPORTANTE: a service_role key da acesso total ao banco - nunca a
# compartilhe nem publique. Fica so aqui no .env (que ja e ignorado pelo Git).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=coloque-aqui-a-service-role-key
SUPABASE_BUCKET=fotos-produtores

